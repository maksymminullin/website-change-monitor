APP_NAME=Website-Monitor-Test
APP_ENV=test
DEBUG=false

HTTP_TIMEOUT_SECONDS=5
HTTP_MAX_CONCURRENCY=1

JWT_SECRET_KEY=test-jwt-secret-key-not-for-production
JWT_REFRESH_SECRET_KEY=test-refresh-secret-key-not-for-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

POSTGRES_USER=test_user
POSTGRES_PASSWORD=test_password
POSTGRES_DB=monitor_test_db
DATABASE_URL=postgresql+asyncpg://test_user:test_password@db:5432/monitor_test_db
